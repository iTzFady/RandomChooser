<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="RandomChooser.App">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.ThemeDictionaries>
                <ResourceDictionary x:Key="Light">
                    <SolidColorBrush x:Key="AppBackgroundBrush" Color="#F5F6F8" />
                    <SolidColorBrush x:Key="SurfaceBrush" Color="#FFFFFF" />
                    <SolidColorBrush x:Key="TextPrimaryBrush" Color="#191A1F" />
                    <SolidColorBrush x:Key="TextSecondaryBrush" Color="#717784" />
                    <SolidColorBrush x:Key="DividerBrush" Color="#E4E7EC" />
                    <SolidColorBrush x:Key="AccentBrush" Color="#4F46E5" />
                    <SolidColorBrush x:Key="AccentHoverBrush" Color="#4338CA" />
                    <SolidColorBrush x:Key="AccentPressedBrush" Color="#3730A3" />
                </ResourceDictionary>
                <ResourceDictionary x:Key="Dark">
                    <SolidColorBrush x:Key="AppBackgroundBrush" Color="#121317" />
                    <SolidColorBrush x:Key="SurfaceBrush" Color="#1C1E24" />
                    <SolidColorBrush x:Key="TextPrimaryBrush" Color="#F5F6F8" />
                    <SolidColorBrush x:Key="TextSecondaryBrush" Color="#9CA3AF" />
                    <SolidColorBrush x:Key="DividerBrush" Color="#2E313A" />
                    <SolidColorBrush x:Key="AccentBrush" Color="#6366F1" />
                    <SolidColorBrush x:Key="AccentHoverBrush" Color="#818CF8" />
                    <SolidColorBrush x:Key="AccentPressedBrush" Color="#4F46E5" />
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>
        </ResourceDictionary>
    </Application.Resources>

    <Application.Styles>
        <FluentTheme />
        <StyleInclude Source="avares://RandomChooser/Styles/Styles.axaml" />
    </Application.Styles>
</Application>
