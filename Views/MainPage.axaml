<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="RandomChooser.Views.MainPage">

    <Grid Margin="48">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
            <Border Classes="card" Width="520" Padding="36">
                <StackPanel HorizontalAlignment="Center">
                    <Image Source="avares://RandomChooser/Assets/Images/dice.png"
                           Width="96" Height="96" Margin="0,0,0,24" />
                    <TextBlock Classes="title" Text="Random Chooser" />
                    <TextBlock Classes="caption" Text="Pick a number or a word, instantly" Margin="0,10,0,0" />
                </StackPanel>
            </Border>

            <StackPanel Margin="0,28,0,0" Width="420">
                <Button Content="Random number" Height="62" FontSize="17" CornerRadius="12"
                        HorizontalAlignment="Stretch" Margin="0,0,0,12" Click="Number_Click" />
                <Button Classes="secondary" Content="Random word" Height="62" FontSize="17" CornerRadius="12"
                        HorizontalAlignment="Stretch" Margin="0,0,0,12" Click="Word_Click" />
                <Button Classes="secondary" Content="Team builder" Height="62" FontSize="17" CornerRadius="12"
                        HorizontalAlignment="Stretch" Click="Team_Click" />
            </StackPanel>
        </StackPanel>

        <Button Grid.Row="1" Classes="icon" Content="⚙" ToolTip.Tip="Settings"
                HorizontalAlignment="Right" VerticalAlignment="Bottom" Click="Settings_Click" />
    </Grid>
</UserControl>
